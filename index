{n:'Hip',t:'Hip flexion',max:120,px:150,py:170,fx:150,fy:40,L:170,sx:1,sy:1,note:'Target: lift the leg about 120° for walking, running and sitting.'},
{n:'Neck',t:'Neck flexion',max:50,px:150,py:240,fx:150,fy:400,L:110,sx:1,sy:-1,head:1,note:'Target: lower the chin about 50° without pain.'}];
const js=document.getElementById('jsvg'),jr=document.getElementById('jr'),jt=document.getElementById('jt'),rm=matchMedia('(prefers-reduced-motion:reduce)').matches;
let cur=0,jUser=rm,jT0=0,jTimer,E={};
function mk(t,a){const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);js.appendChild(e);return e}
function build(i){cur=i;const j=J[i];js.innerHTML='';
const tx=j.px+j.L*j.sx*Math.sin(j.max/57.3),ty=j.py+j.L*j.sy*Math.cos(j.max/57.3);
mk('line',{x1:j.px,y1:j.py,x2:tx,y2:ty,stroke:'#60A5FA','stroke-width':3,'stroke-dasharray':'6 8',opacity:.7});
mk('line',{x1:j.px,y1:j.py,x2:j.fx,y2:j.fy,stroke:'#60A5FA','stroke-width':26,'stroke-linecap':'round'});
E.arc=mk('path',{fill:'none',stroke:'#fff','stroke-width':3});
E.mv=mk('line',{x1:j.px,y1:j.py,stroke:'#DBEAFE','stroke-width':20,'stroke-linecap':'round'});
E.hd=j.head?mk('circle',{r:30,fill:'#DBEAFE'}):null;
mk('circle',{cx:j.px,cy:j.py,r:14,fill:'#2563EB',class:'ring'});
mk('circle',{cx:j.px,cy:j.py,r:12,fill:'#2563EB',stroke:'#fff','stroke-width':3});
document.getElementById('jname').textContent=j.t;document.getElementById('jnote').textContent=j.note;
[...jt.children].forEach((b,k)=>b.setAttribute('aria-selected',k===i));jT0=performance.now();set(0)}
function set(d){const j=J[cur],r=d/57.3,ex=j.px+j.L*j.sx*Math.sin(r),ey=j.py+j.L*j.sy*Math.cos(r);
E.mv.setAttribute('x2',ex);E.mv.setAttribute('y2',ey);
if(E.hd){E.hd.setAttribute('cx',ex);E.hd.setAttribute('cy',ey)}
const R=64,ax=j.px+R*j.sx*Math.sin(r),ay=j.py+R*j.sy*Math.cos(r);
E.arc.setAttribute('d',`M${j.px} ${j.py+R*j.sy} A${R} ${R} 0 0 ${j.sx*j.sy<0?1:0} ${ax} ${ay}`);
document.getElementById('jdeg').textContent=Math.round(d)+'°';document.getElementById('jfill').style.width=(d/j.max*100)+'%';jr.value=Math.round(d/j.max*100)}
J.forEach((j,i)=>{const b=document.createElement('button');b.role='tab';b.textContent=j.n;b.onclick=()=>{if(!rm)jUser=false;build(i)};jt.appendChild(b)});
build(0);
(function loop(t){if(!jUser)set(J[cur].max*(0.5-0.5*Math.cos((t-jT0)/1300)));requestAnimationFrame(loop)})(0);
jr.addEventListener('input',()=>{jUser=true;clearTimeout(jTimer);set(J[cur].max*jr.value/100);if(!rm)jTimer=setTimeout(()=>{const d=J[cur].max*jr.value/100;jT0=performance.now()-Math.acos(1-2*d/J[cur].max)*1300;jUser=false},2500)});

// Timeline fill
const tm=document.getElementById('tm'),bar=tm.querySelector('i'),steps=[...tm.querySelectorAll('.step')];
function tick(){const r=tm.getBoundingClientRect(),h=innerHeight*.6,p=Math.max(0,Math.min(r.height,h-r.top));bar.style.height=p+'px';steps.forEach(s=>s.classList.toggle('on',s.getBoundingClientRect().top<h))}
addEventListener('scroll',tick,{passive:true});tick();
</script>
</body>
